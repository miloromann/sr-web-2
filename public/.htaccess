# DreamHost — drop this in the site root (same folder as index.html)
# Serves /work/slug/ folders cleanly; falls back to 404.html if present.

Options -MultiViews
RewriteEngine On

# If the request is a real file or directory, serve it
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise try adding a trailing slash (Next export folders)
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ /$1/ [R=301,L]
